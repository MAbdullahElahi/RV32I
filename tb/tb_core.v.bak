`timescale 1ns/1ps

module tb_core;
    reg clk;
    reg rst;

    integer pass_count = 0;
    integer fail_count = 0;

    core_top uut (
        .clk (clk),
        .rst (rst)
    );

    // 100 MHz clock (10 ns period)
    always #5 clk = ~clk;

    task assert_reg;
        input [4:0]  reg_num;
        input [31:0] exp_val;
        begin
            if (uut.rf.rf[reg_num] === exp_val) begin
                $display("[PASS] x%0d = 0x%08h (%0d)", reg_num, uut.rf.rf[reg_num], $signed(uut.rf.rf[reg_num]));
                pass_count = pass_count + 1;
            end else begin
                $display("[FAIL] x%0d = 0x%08h, Expected 0x%08h", reg_num, uut.rf.rf[reg_num], exp_val);
                fail_count = fail_count + 1;
            end
        end
    endtask

    initial begin
        clk = 0;
        rst = 1;

        // Load RV32I verification program into Instruction ROM
        // 0x00: addi x1, x0, 10        -> x1 = 10
        uut.imem.mem[0]  = 32'h00A0_0093;
        // 0x04: addi x2, x0, 20        -> x2 = 20
        uut.imem.mem[1]  = 32'h0140_0113;
        // 0x08: add  x3, x1, x2        -> x3 = 30 (0x1E)
        uut.imem.mem[2]  = 32'h0020_81B3;
        // 0x0C: sub  x4, x2, x1        -> x4 = 10 (0x0A)
        uut.imem.mem[3]  = 32'h4011_0233;
        // 0x10: slli x5, x1, 2         -> x5 = 40 (0x28)
        uut.imem.mem[4]  = 32'h0020_9293;
        // 0x14: lui  x6, 0x12345       -> x6 = 0x12345000
        uut.imem.mem[5]  = 32'h1234_5337;
        // 0x18: addi x7, x0, -5        -> x7 = 0xFFFFFFFB (-5)
        uut.imem.mem[6]  = 32'hFFB0_0393;
        // 0x1C: sw   x7, 0(x0)         -> dmem[0] = 0xFFFFFFFB
        uut.imem.mem[7]  = 32'h0070_2023;
        // 0x20: lb   x8, 0(x0)         -> x8 = 0xFFFFFFFB (sign-extended)
        uut.imem.mem[8]  = 32'h0000_0403;
        // 0x24: lbu  x9, 0(x0)         -> x9 = 0x000000FB (zero-extended)
        uut.imem.mem[9]  = 32'h0000_4483;
        // 0x28: addi x10, x0, 3        -> loop counter x10 = 3
        uut.imem.mem[10] = 32'h0030_0513;
        // 0x2C: addi x10, x10, -1      -> loop body: x10--
        uut.imem.mem[11] = 32'hFFF5_0513;
        // 0x30: bne  x10, x0, -4       -> branch back to 0x2C while x10 != 0
        uut.imem.mem[12] = 32'hFE05_1EE3;
        // 0x34: jal  x11, 8            -> x11 = 0x38 (return addr), jump to 0x3C
        uut.imem.mem[13] = 32'h0080_05EF;
        // 0x38: addi x12, x0, 99       -> SKIPPED by JAL (x12 must stay 0)
        uut.imem.mem[14] = 32'h0630_0613;
        // 0x3C: addi x13, x0, 77       -> Executed after JAL: x13 = 77
        uut.imem.mem[15] = 32'h04D0_0693;
        // 0x40: ebreak                 -> End of test program
        uut.imem.mem[16] = 32'h0010_0073;

        // Release reset and run for 25 clock cycles
        #12;
        rst = 0;
        repeat (25) @(posedge clk);
        #2;

        $display("==================================================");
        $display("       RV32I Full Core Verification Results       ");
        $display("==================================================");
        assert_reg(5'd1,  32'd10);
        assert_reg(5'd2,  32'd20);
        assert_reg(5'd3,  32'd30);
        assert_reg(5'd4,  32'd10);
        assert_reg(5'd5,  32'd40);
        assert_reg(5'd6,  32'h1234_5000);
        assert_reg(5'd7, -32'd5);
        assert_reg(5'd8, -32'd5);
        assert_reg(5'd9,  32'h0000_00FB);
        assert_reg(5'd10, 32'd0);
        assert_reg(5'd11, 32'h0000_0038);
        assert_reg(5'd12, 32'd0);
        assert_reg(5'd13, 32'd77);

        if (uut.dmem.dmem[0] === -32'd5) begin
            $display("[PASS] dmem[0] = 0x%08h", uut.dmem.dmem[0]);
            pass_count = pass_count + 1;
        end else begin
            $display("[FAIL] dmem[0] = 0x%08h, Expected 0xFFFFFFFB", uut.dmem.dmem[0]);
            fail_count = fail_count + 1;
        end

        $display("==================================================");
        $display("Core Summary: %0d PASSED, %0d FAILED", pass_count, fail_count);
        $display("==================================================");
        $stop;
    end
endmodule